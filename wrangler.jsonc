{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aec-hackathon-grader",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [{ "pattern": "hackathon.acelabusa.com", "custom_domain": true }],

  // Static assets: the web UI plus the datasets.
  // The Worker runs first for /api/* and /datasets/* so the datasets
  // are never served to the public.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/datasets/*"]
  },

  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aec-hackathon",
      "database_id": "d5e08b4d-394d-4e69-a513-adb79bec427e"
    }
  ],

  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "MAX_TEST_RUNS": "3",
    "MAX_FINAL_RUNS": "1",
    "RUN_TIMEOUT_SECONDS": "600",
    "MAX_CONCURRENT_RUNS": "3",
    "MAX_LLM_CALLS_PER_RUN": "300",
    "MAX_REPO_MB": "25"
  },

  "observability": { "enabled": true }
}
